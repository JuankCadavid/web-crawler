# IGAD Innovations Hub - Environment Variables
# Copy this file to .env and update with your actual values

# ===== ENVIRONMENT =====
NODE_ENV=development
PORT=3001

# ===== DATABASE (Local Development) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=igad
DB_PASSWORD=password
DB_NAME=igad_hub

# ===== AWS CONFIGURATION =====
AWS_REGION=us-east-1
AWS_PROFILE=default

# ===== COGNITO (Will be populated by SAM deployment) =====
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=us-east-1

# ===== S3 BUCKETS (Will be populated by SAM deployment) =====
S3_BUCKET=igad-hub-documents-123456789012
S3_REGION=us-east-1

# ===== SQS/SNS (Will be populated by SAM deployment) =====
SQS_SCRAPER_QUEUE=https://sqs.us-east-1.amazonaws.com/123456789012/igad-hub-scraper-queue
SNS_NOTIFICATIONS_TOPIC=arn:aws:sns:us-east-1:123456789012:igad-hub-notifications

# ===== AMAZON Q / BEDROCK =====
AMAZON_Q_APPLICATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ===== API CONFIGURATION =====
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# ===== RATE LIMITING =====
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===== LOGGING =====
LOG_LEVEL=debug
LOG_FORMAT=json

# ===== FRONTEND CONFIGURATION =====
VITE_API_BASE_URL=http://localhost:3001
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_REGION=us-east-1
VITE_AWS_REGION=us-east-1

# ===== SCRAPER CONFIGURATION =====
SCRAPER_USER_AGENT=IGAD-Hub-Bot/1.0
SCRAPER_RATE_LIMIT=1000
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3

# ===== EMAIL CONFIGURATION =====
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@igad.org
SES_REPLY_TO_EMAIL=support@igad.org

# ===== MONITORING =====
ENABLE_XRAY_TRACING=true
ENABLE_PERFORMANCE_MONITORING=true

# ===== COST MONITORING =====
COST_BUDGET_MONTHLY=85
COST_ALERT_THRESHOLD=80

# ===== SECURITY =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# ===== AI USAGE LIMITS =====
AI_MONTHLY_LIMIT_PER_USER=50
AI_DAILY_LIMIT_PER_USER=10
AI_COST_LIMIT_MONTHLY=300

# ===== FEATURE FLAGS =====
ENABLE_AI_FEATURES=true
ENABLE_SCRAPER=true
ENABLE_NEWSLETTERS=true
ENABLE_COLLABORATION=true

# ===== DEVELOPMENT TOOLS =====
ENABLE_SWAGGER=true
ENABLE_DEBUG_LOGS=true
ENABLE_HOT_RELOAD=true

# ===== TESTING =====
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USERNAME=test_user
TEST_DB_PASSWORD=test_password
TEST_DB_NAME=igad_hub_test

# ===== DEPLOYMENT =====
STACK_NAME=igad-hub-test
DEPLOYMENT_ENVIRONMENT=test
DEPLOYMENT_REGION=us-east-1

# ===== GITHUB ACTIONS (Repository Secrets) =====
# These should be set as GitHub repository secrets, not in .env files
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/GitHubActionsRole
# TEST_S3_BUCKET=igad-hub-static-test-123456789012
# PROD_S3_BUCKET=igad-hub-static-prod-123456789012
# TEST_CLOUDFRONT_ID=E1234567890ABC
# PROD_CLOUDFRONT_ID=E0987654321XYZ

# ===== LOCAL DEVELOPMENT OVERRIDES =====
# Uncomment and modify these for local development
# DB_HOST=host.docker.internal  # For Docker Desktop
# API_BASE_URL=http://host.docker.internal:3001  # For containerized frontend

# ===== OPTIONAL INTEGRATIONS =====
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# DATADOG_API_KEY=your-datadog-api-key
# SENTRY_DSN=https://xxx@sentry.io/yyy

# ===== PERFORMANCE TUNING =====
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=2000
DB_IDLE_TIMEOUT=30000
LAMBDA_MEMORY_SIZE=1024
LAMBDA_TIMEOUT=30

# ===== BACKUP CONFIGURATION =====
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM UTC

# ===== CONTENT MODERATION =====
ENABLE_CONTENT_MODERATION=true
CONTENT_MODERATION_THRESHOLD=0.8

# ===== ANALYTICS =====
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# ===== CACHE CONFIGURATION =====
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
ENABLE_CACHE=false  # Set to true if using Redis

# ===== FILE UPLOAD LIMITS =====
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,txt,md,jpg,png,gif

# ===== INTERNATIONALIZATION =====
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,ar,sw  # English, French, Arabic, Swahili

# ===== MAINTENANCE MODE =====
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."
